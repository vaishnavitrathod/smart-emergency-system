# Flask API. On a phone use your PC's LAN IP, e.g. http://192.168.1.20:5000
EXPO_PUBLIC_API_URL=http://localhost:5000

# Set the official emergency number for the country where this deployment operates.
EXPO_PUBLIC_EMERGENCY_NUMBER=
# Optional local authority/contact number shown beside the official number.
EXPO_PUBLIC_LOCAL_RESPONSE_NUMBER=
# Optional email-domain restriction. Leave blank to allow any valid email domain.
EXPO_PUBLIC_ALLOWED_EMAIL_DOMAIN=
# Optional country code used when a phone is entered without a leading +country code.
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=
# Optional city center used only when no current user location is available.
EXPO_PUBLIC_MAP_CENTER=
EXPO_PUBLIC_DEFAULT_LANGUAGE=en
EXPO_PUBLIC_SUPPORTED_LANGUAGES=en,hi
EXPO_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_TRACKING_BASE_URL=
EXPO_PUBLIC_OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
EXPO_PUBLIC_OSRM_DRIVING_URL=https://router.project-osrm.org
EXPO_PUBLIC_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Firebase Web app config (Firebase console > Project settings > Your apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

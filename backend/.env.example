# Optional. Without a key the keyword fallback classifier is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Firebase Admin credentials: set one credential source. Keep secrets out of source control.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT_JSON=

# The dispatch poller stores assignment deadlines in Firestore and resumes after restarts.
DISPATCH_WORKER_ENABLED=true
# Run a single API instance and one Gunicorn worker for the in-process dispatch poller.
CORS_ORIGINS=*
LOCATION_RETENTION_DAYS=30

# Twilio contact SMS. If any value is missing, the app records mock mode instead.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Optional Twilio Verify Service SID for phone-number OTP verification.
TWILIO_VERIFY_SERVICE_SID=
PUBLIC_TRACKING_BASE_URL=
